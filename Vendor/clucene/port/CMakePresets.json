{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "mobile-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CLUCENE_BUILD_TESTS": "OFF",
        "CLUCENE_BUILD_HIGHLIGHTER": "OFF"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "mobile-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.6",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
      }
    },
    {
      "name": "ios-device",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphoneos" }
    },
    {
      "name": "ios-simulator",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "mobile-base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-23",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "android-arm64",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "inherits": "android-base",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "host-debug",
      "inherits": "mobile-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CLUCENE_BUILD_TESTS": "ON"
      }
    }
  ]
}